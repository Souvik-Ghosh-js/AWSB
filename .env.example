# Attar World Sonar Bangla — API environment
# Copy to .env and fill in. NEVER commit .env.

NODE_ENV=development
PORT=4000

# ---- URLs -------------------------------------------------------------
# Single swap point for the domain. Used for CORS, email links, sitemap,
# and the Razorpay webhook URL. Change here and nowhere else.
SITE_URL=http://localhost:3000
API_URL=http://localhost:4000

# ---- Database ---------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=awsb
DB_PASSWORD=
DB_NAME=awsb
DB_CONNECTION_LIMIT=10

# ---- Razorpay ---------------------------------------------------------
# Test keys start rzp_test_, live keys rzp_live_.
# The key secret is shown ONCE at generation - store it now.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# NOT the same as RAZORPAY_KEY_SECRET. This is the webhook secret you set
# in the Razorpay dashboard. Using the key secret here silently fails
# every webhook signature check.
RAZORPAY_WEBHOOK_SECRET=

# ---- Auth -------------------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=12h

# ---- Email (Nodemailer over Gmail SMTP) -------------------------------
# SMTP_PASSWORD is a Google App Password, NOT the account password.
# Requires 2FA enabled: myaccount.google.com/apppasswords
# Limits: ~500/day, sends from a gmail.com identity (some inboxes filter it).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sangatdutta65@gmail.com
SMTP_PASSWORD=
MAIL_FROM_NAME=Attar World Sonar Bangla
MAIL_FROM_ADDRESS=sangatdutta65@gmail.com
# Admin alerts (new order, low stock) go here.
ADMIN_ALERT_EMAIL=sangatdutta65@gmail.com

# ---- Object storage (Lightsail / S3-compatible) -----------------------
STORAGE_DRIVER=s3
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_REGION=ap-south-1
S3_BUCKET=awsb-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ---- Behaviour --------------------------------------------------------
# Stock is reserved at checkout; this is how long before a sweeper releases it.
RESERVATION_MINUTES=30
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
